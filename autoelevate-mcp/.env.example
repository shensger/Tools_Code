# AutoElevate portal user for the MCP. Use a dedicated local-password user (not Entra SSO)
# with the least role that can view requests/rules and approve/deny.
AE_EMAIL=
AE_PASSWORD=
# Base32 TOTP secret from the user's 2FA setup (the secret behind the QR code).
AE_TOTP_SECRET=
# Optional: a current portal token instead of email/password (expires after 24h).
AE_TOKEN=

# Threat intel
VT_API_KEY=
NVD_API_KEY=

# Optional overrides
AE_BASELINE_DIR=
AE_POLICY=
AE_CONTROL_MAP=
