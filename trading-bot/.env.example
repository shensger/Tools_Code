# Copy to .env and fill in. Get keys at https://app.alpaca.markets (Paper Trading > API Keys)
ALPACA_API_KEY=your_paper_key
ALPACA_SECRET_KEY=your_paper_secret

# Leave true until you've watched it on paper for a while.
# Going live needs BOTH this set to false AND running: python bot.py --live
ALPACA_PAPER=true

SYMBOL=SPY             # ETF to trade
SMA_DAYS=200           # trend filter length
BUFFER_PCT=1.0         # % band around the SMA to avoid whipsaw trades
MAX_TRADE_USD=50       # hard cap on any single buy
CASH_CUSHION_PCT=2     # leave this % of cash unspent
